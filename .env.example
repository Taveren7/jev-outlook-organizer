# Local only. Never commit this file after adding real values.
TYPESAFE_API_KEY=
MS_TENANT_ID=
MS_CLIENT_ID=
# Use the client secret VALUE, not the secret ID.
MS_CLIENT_SECRET=
# Prefer the mailbox user's Entra object ID (GUID).
MS_MAILBOX_ID=
# Optional second mailbox for a negative scope check. No content is retrieved.
MS_DENIED_MAILBOX_ID=
# Choose your own Cloudflare Worker name (lowercase letters, digits, hyphens).
WORKER_NAME=my-jev-organizer
# Required: copy the account ID from npx wrangler whoami.
CLOUDFLARE_ACCOUNT_ID=
# setup init generates a random admin credential here.
ADMIN_TOKEN=
# Fill from the deployment result. Secrets are never placed in this URL.
JEV_SERVICE_URL=
